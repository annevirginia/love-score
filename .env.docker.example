# Domain configuration for automatic SSL/HTTPS certificate via Caddy
# Set this to your public domain or free dynamic DNS hostname (e.g. lovescore.duckdns.org)
# If empty, Caddy will serve on HTTP port 80 for local testing.
DOMAIN=

# Email for Let's Encrypt SSL/TLS renewal notices
ACME_EMAIL=your-email@gmail.com

# Next.js API Base URL (leave empty when using Caddy reverse proxy on same domain)
NEXT_PUBLIC_API_URL=

# CORS Settings
FRONTEND_URL=
ALLOWED_ORIGINS=
